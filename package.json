{
  "name": "riverloop-studio",
  "version": "0.3.0",
  "description": "Annotate your app under development (web, Electron or native window) and send the changes to Claude Code, in the same terminal session. Independent project, not affiliated with Anthropic.",
  "author": "Riverloop SRLS",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClauWeb69/riverloop-studio.git"
  },
  "homepage": "https://github.com/ClauWeb69/riverloop-studio#readme",
  "bugs": {
    "url": "https://github.com/ClauWeb69/riverloop-studio/issues"
  },
  "type": "module",
  "bin": {
    "riverloop-studio": "dist/bin/cli.js"
  },
  "exports": {
    "./vite": {
      "types": "./dist/src/plugin/vite.d.ts",
      "default": "./dist/src/plugin/vite.js"
    },
    "./babel": {
      "types": "./dist/src/plugin/babel.d.cts",
      "default": "./dist/src/plugin/babel.cjs"
    },
    "./loader": {
      "types": "./dist/src/plugin/loader.d.cts",
      "default": "./dist/src/plugin/loader.cjs"
    },
    "./next": {
      "types": "./dist/src/plugin/next.d.cts",
      "default": "./dist/src/plugin/next.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web && npm run build:overlay",
    "build:server": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "build:web": "vite build --config vite.web.config.ts",
    "build:overlay": "vite build --config vite.overlay.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:e2e": "node test/e2e/run.mjs",
    "test:e2e:electron": "node test/e2e/electron.mjs",
    "test:e2e:window": "node test/e2e/window.mjs",
    "prepare": "npm run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/headless": "6.0.0",
    "commander": "^14.0.3",
    "get-port": "^7.2.0",
    "http-proxy": "^1.18.1",
    "magic-string": "^0.30.21",
    "open": "^11.0.4",
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@types/babel__core": "^7.20.5",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "html-to-image": "1.11.13",
    "playwright-core": "1.56.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "claude-code",
    "claude",
    "ai",
    "annotations",
    "visual-feedback",
    "devtools",
    "electron",
    "nextjs",
    "vite",
    "developer-tools"
  ]
}
